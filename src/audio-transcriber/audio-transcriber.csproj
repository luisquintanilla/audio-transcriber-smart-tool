<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>audio-transcriber</AssemblyName>
    <RootNamespace>AudioTranscriber.Cli</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <PackageId>audio-transcriber</PackageId>
    <Version>0.1.0</Version>
    <Authors>luisquintanilla</Authors>
    <Description>Local audio preparation and Whisper speech transcription as a library-first Smart Tool.</Description>
    <RepositoryUrl>https://github.com/luisquintanilla/audio-transcriber-smart-tool</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/luisquintanilla/audio-transcriber-smart-tool</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <ToolCommandName>audio-transcriber</ToolCommandName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AudioTranscriber\AudioTranscriber.csproj" />
    <None Include="..\..\README.md" Pack="true" PackagePath="README.md" />
    <None Include="..\AudioTranscriber\SMART_TOOL.md" Pack="true" PackagePath="src\AudioTranscriber\SMART_TOOL.md" />
    <None Include="..\..\smart-tool.json" Pack="true" PackagePath="smart-tool.json" />
  </ItemGroup>

</Project>
